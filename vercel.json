{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.bnbpay.org/:path*" },
    { "source": "/invoice/:id", "destination": "/index.html" },
    { "source": "/subscription/:id", "destination": "/index.html" },
    { "source": "/((?!assets|history|calendar|api).*)", "destination": "/index.html" }
  ]
}
