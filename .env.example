# BNBPay Payments UI - Environment Configuration
# Copy this file to .env.local for development or .env.production for production

# ============================================================================
# Network Configuration
# ============================================================================

# Network mode: 'testnet' or 'mainnet'
VITE_NETWORK_MODE=testnet

# Mainnet safety flag - MUST be true to use mainnet
VITE_MAINNET_ENABLED=false

# Chain Configuration (for reference)
VITE_CHAIN_ID=97
VITE_NETWORK_NAME=BNB Testnet
VITE_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ============================================================================
# Testnet Contract Addresses (BSC Testnet - Chain ID 97)
# ============================================================================

VITE_TESTNET_PAYMENT_REGISTRY=0x...
VITE_TESTNET_BNBPAY_ROUTER=0x...
VITE_TESTNET_SUBSCRIPTION_MANAGER=0x...
VITE_TESTNET_SESSION_STORE=0x...

# Testnet Token Addresses
VITE_TESTNET_TOKEN_USDT=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
VITE_TESTNET_TOKEN_USDC=0x64544969ed7EBf5f083679233325356EbE738930
VITE_TESTNET_TOKEN_USD1=0x...
VITE_TESTNET_TOKEN_WUSD=0x...
VITE_TESTNET_TOKEN_XUSD=0x...

# Legacy Token Config (for backward compatibility)
VITE_TOKEN_BNB=0x0000000000000000000000000000000000000000
VITE_TOKEN_USDT=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
VITE_TOKEN_BUSD=0xeD24FC36d5Ee211Ea25A80239Fb8C4Cfd80f12Ee

# ============================================================================
# Mainnet Contract Addresses (BSC Mainnet - Chain ID 56)
# ============================================================================

VITE_MAINNET_PAYMENT_REGISTRY=
VITE_MAINNET_BNBPAY_ROUTER=
VITE_MAINNET_SUBSCRIPTION_MANAGER=
VITE_MAINNET_SESSION_STORE=

# Mainnet Token Addresses (Official BEP-20 tokens)
VITE_MAINNET_TOKEN_USDT=0x55d398326f99059fF775485246999027B3197955
VITE_MAINNET_TOKEN_USDC=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
VITE_MAINNET_TOKEN_USD1=
VITE_MAINNET_TOKEN_WUSD=
VITE_MAINNET_TOKEN_XUSD=

# ============================================================================
# Contract Addresses (Legacy)
# ============================================================================

VITE_PAYMENT_REGISTRY=0xYourPaymentRegistryAddress
VITE_BNBPAY_ROUTER=0xYourBNBPayRouterAddress
VITE_SUBSCRIPTION_MANAGER=0xYourSubscriptionManagerAddress

# Permit2 (canonical deployment on all chains)
VITE_PERMIT2_ADDRESS=0x000000000022D473030F116DDEE9F6B43AC78BA3

# ============================================================================
# API Configuration
# ============================================================================

# Testnet API
VITE_API_URL_TESTNET=https://api.bnbpay.org
VITE_WS_URL_TESTNET=wss://api.bnbpay.org

# Mainnet API
VITE_API_URL_MAINNET=https://api.bnbpay.org
VITE_WS_URL_MAINNET=wss://api.bnbpay.org

# API Settings
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# ============================================================================
# Explorer Configuration
# ============================================================================

VITE_BLOCK_EXPLORER=https://testnet.bscscan.com
VITE_BLOCK_EXPLORER_API=https://api-testnet.bscscan.com/api

# ============================================================================
# Feature Flags
# ============================================================================

# Enable gasless (meta-transaction) payments
VITE_FEATURE_GASLESS=true

# Enable multi-token settlement with DEX swap
VITE_FEATURE_MULTI_TOKEN=true

# Enable Server-Sent Events for realtime updates
VITE_FEATURE_SSE=true

# Debug mode - MUST be false in production
VITE_DEBUG_MODE=true

# Show testnet warning banner
VITE_ENABLE_TESTNET_WARNING=true

# ============================================================================
# Application Settings
# ============================================================================

VITE_APP_NAME=BNBPay & X402 Flex
VITE_APP_DESCRIPTION=Multi-token payments on BNB Chain
