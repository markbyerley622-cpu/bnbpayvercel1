# BNBPay UI Configuration - Example

# Network Configuration
VITE_CHAIN_ID=97
VITE_NETWORK_NAME=BNB Testnet

# RPC Endpoint
VITE_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Deployed Contract Addresses (update after deployment)
VITE_PAYMENT_REGISTRY=0xYourPaymentRegistryAddress
VITE_BNBPAY_ROUTER=0xYourBNBPayRouterAddress
VITE_SUBSCRIPTION_MANAGER=0xYourSubscriptionManagerAddress

# Permit2 (canonical deployment on all chains)
VITE_PERMIT2_ADDRESS=0x000000000022D473030F116DDEE9F6B43AC78BA3

# Token Addresses (Testnet)
VITE_TOKEN_BNB=0x0000000000000000000000000000000000000000
VITE_TOKEN_USDT=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
VITE_TOKEN_BUSD=0xeD24FC36d5Ee211Ea25A80239Fb8C4Cfd80f12Ee

# Explorer URLs
VITE_BLOCK_EXPLORER=https://testnet.bscscan.com
VITE_BLOCK_EXPLORER_API=https://api-testnet.bscscan.com/api

# Application Settings
VITE_APP_NAME=BNBPay & X402 Flex
VITE_APP_DESCRIPTION=Multi-token payments on BNB Chain
VITE_ENABLE_TESTNET_WARNING=true
